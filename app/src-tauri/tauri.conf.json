{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenF75",
  "version": "0.1.0",
  "identifier": "io.github.pendiego.openf75",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenF75",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDN0Q3NEYxQzEwNTMzRTgKUldUb013WEI4WFI5dk1FYmxLRDYvcDYxdlppcWJQcVZVN3g1d0tMdElHUFMwSDBveVh0c0JWVHYK",
      "endpoints": [
        "https://github.com/pendiego/openf75/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
